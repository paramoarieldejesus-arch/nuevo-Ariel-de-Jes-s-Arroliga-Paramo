#método para detectar si hay ciclos en un grafo dirigido.
def tiene_ciclo(grafo):
    visitados = set()
    pila = set()

    def dfs(nodo):
        visitados.add(nodo)
        pila.add(nodo)

        for vecino in grafo[nodo]:
            if vecino not in visitados:
                if dfs(vecino):
                    return True
            elif vecino in pila:
                return True

        pila.remove(nodo)
        return False

    for nodo in grafo:
        if nodo not in visitados:
            if dfs(nodo):
                return True

    return False


# Crear un grafo dirigido
grafo = {
    'A': ['B'],
    'B': ['C'],
    'C': ['A']
}

if tiene_ciclo(grafo):
    print("El grafo tiene un ciclo")
else:
    print("El grafo no tiene ciclos")
