#método que retorne el camino exacto (lista de nodos) tras ejecutar Dijkstra, no solo la distancia.
import heapq

def dijkstra(grafo, inicio, destino):
    distancias = {inicio: 0}
    anteriores = {}
    cola = [(0, inicio)]

    while cola:
        distancia, nodo = heapq.heappop(cola)

        if nodo == destino:
            break

        if distancia > distancias[nodo]:
            continue

        for vecino, peso in grafo.get(nodo, []):
            nueva_distancia = distancia + peso

            if nueva_distancia < distancias.get(vecino, float('inf')):
                distancias[vecino] = nueva_distancia
                anteriores[vecino] = nodo
                heapq.heappush(cola, (nueva_distancia, vecino))

    if destino not in distancias:
        return []

    camino = []
    actual = destino

    while actual != inicio:
        camino.append(actual)
        actual = anteriores[actual]

    camino.append(inicio)
    camino.reverse()

    return camino


# Crear un grafo ponderado
grafo = {
    'A': [('B', 10), ('C', 4)],
    'B': [('D', 5)],
    'C': [('B', 2), ('D', 12)],
    'D': []
}

camino = dijkstra(grafo, 'A', 'D')

print("Camino exacto:", camino)
